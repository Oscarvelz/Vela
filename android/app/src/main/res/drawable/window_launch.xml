<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (no system splash): the window itself shows the lit flame on the Firmament navy until the page paints
     its splash at the same spot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vela_night" />
    <item android:gravity="center" android:width="288dp" android:height="288dp" android:drawable="@drawable/splash_flame" />
</layer-list>
